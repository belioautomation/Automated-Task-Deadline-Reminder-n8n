    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "= {{   $json.reminder_reason === \"Overdue task\"     ? \"OVERDUE: \" + $json.task_name     : $json.reminder_reason === \"Due today\"     ? \"Due Today: \" + $json.task_name     : \"Upcoming Deadline: \" + $json.task_name }}",
        "emailType": "text",
        "message": "=\n{{\n  \"Hello,\\n\\n\" +\n  \"This is an automated reminder about your task.\\n\\n\" +\n  \"TASK DETAILS\\n\" +\n  \"----------------------------\\n\" +\n  \"Task ID: \" + $json.task_id + \"\\n\" +\n  \"Task Name: \" + $json.task_name + \"\\n\" +\n  \"Description: \" + $json.description + \"\\n\" +\n  \"Due Date: \" + $json.due_date + \"\\n\" +\n  \"Priority: \" + $json.priority + \"\\n\" +\n  \"Status: \" + $json.status + \"\\n\" +\n  \"Reminder: \" + $json.reminder_reason + \"\\n\\n\" +\n  \"Days Until Deadline: \" +\n  (\n    $json.days_until_due < 0\n      ? Math.abs($json.days_until_due) + \" days overdue\"\n      : $json.days_until_due + \" days remaining\"\n  ) +\n  \"\\n\\nPlease make sure to complete this task on time.\\n\\n\" +\n  \"Best regards,\\n\" +\n  \"Automated Task Reminder System\"\n}}\n",
        "options": {
          "appendAttribution": false
        }
      },
