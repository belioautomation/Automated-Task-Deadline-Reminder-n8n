    {
      "parameters": {
        "jsCode": "\nconst tasks = $input.all();\n\n// Get today's date in Manila timezone\nconst today = new Intl.DateTimeFormat(\"en-CA\", {\n  timeZone: \"Asia/Manila\",\n  year: \"numeric\",\n  month: \"2-digit\",\n  day: \"2-digit\"\n}).format(new Date());\n\nconst todayDate = new Date(today + \"T00:00:00Z\");\n\n// Normalize dates from Google Sheets\nfunction normalizeDate(value) {\n  if (!value) return \"\";\n\n  const match = String(value).trim().match(/^(\\d{4}-\\d{2}-\\d{2})/);\n\n  if (!match) return \"\";\n\n  const date = match[1];\n  const parsed = new Date(date + \"T00:00:00Z\");\n\n  return !isNaN(parsed.getTime()) &&\n    parsed.toISOString().slice(0, 10) === date\n      ? date\n      : \"\";\n}\n\nreturn tasks.map(item => {\n  const task = item.json;\n\n  // Task information\n  const taskId = task.task_id;\n  const taskName = task.task_name;\n  const dueDate = normalizeDate(task.due_date);\n  const priority = task.priority;\n  const status = String(task.status || \"\").trim();\n  const email = String(task.email || \"\").trim();\n\n  const reminderDays = Number(task.reminder_days);\n  const lastReminded = normalizeDate(task.last_reminded);\n\n  // Default values\n  let shouldRemind = false;\n  let reminderReason = \"No reminder required\";\n  let daysUntilDue = null;\n  let reminderStatus = \"Not Required\";\n\n  // Validate due date\n  if (!dueDate) {\n    reminderReason = \"Invalid or missing due date\";\n    reminderStatus = \"Invalid Date\";\n\n  } else {\n    const deadline = new Date(dueDate + \"T00:00:00Z\");\n\n    daysUntilDue = Math.round(\n      (deadline - todayDate) / 86400000\n    );\n\n    // Completed tasks\n    if (status.toLowerCase() === \"completed\") {\n      reminderReason = \"Task already completed\";\n      reminderStatus = \"Completed\";\n\n    // Invalid email\n    } else if (!email.includes(\"@\")) {\n      reminderReason = \"Invalid recipient email\";\n      reminderStatus = \"Invalid Email\";\n\n    // Check reminder days\n    } else if (\n      !Number.isFinite(reminderDays) ||\n      reminderDays < 0\n    ) {\n      reminderReason = \"Invalid reminder days\";\n      reminderStatus = \"Invalid Configuration\";\n\n    // Already reminded today\n    } else if (lastReminded === today) {\n      reminderReason = \"Already reminded today\";\n      reminderStatus = \"Already Sent Today\";\n\n    // Eligible for reminder\n    } else if (daysUntilDue <= reminderDays) {\n\n      shouldRemind = true;\n      reminderStatus = \"Ready to Send\";\n\n      if (daysUntilDue < 0) {\n        reminderReason = \"Overdue task\";\n      } else if (daysUntilDue === 0) {\n        reminderReason = \"Due today\";\n      } else {\n        reminderReason = \"Upcoming deadline\";\n      }\n\n    } else {\n      reminderReason = \"Outside reminder window\";\n      reminderStatus = \"Not Required\";\n    }\n  }\n\n  // Preserve the previous reminder date\n  const lastRemindedDisplay = lastReminded || \"Never\";\n\n  return {\n    json: {\n      ...task,\n\n      // Deadline calculations\n      days_until_due: daysUntilDue,\n      should_remind: shouldRemind,\n      reminder_reason: reminderReason,\n\n      // Reminder tracking\n      last_reminded: lastReminded,\n      last_reminded_display: lastRemindedDisplay,\n      reminder_status: reminderStatus,\n      reminder_status_display: reminderStatus,\n\n      // Additional information\n      checked_date: today,\n      reminder_priority: priority\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
